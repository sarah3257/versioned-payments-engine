{
  "package": {
    "requestId": "emergency-example",
    "publisher": "POC",
    "templates": [
      {
        "id": "emergency",
        "version": 1,
        "name": "חירום: דריסה או מחיר × מכפיל × כמות",
        "parameters": [],
        "facts": [
          {
            "name": "supportLevel",
            "type": "number",
            "required": true
          },
          {
            "name": "quantity",
            "type": "number",
            "required": true
          }
        ],
        "steps": [
          {
            "key": "prices",
            "expression": "filter(refs, #.id == item.priceId)",
            "assert": false
          },
          {
            "key": "validPrice",
            "expression": "item.override != null or len(s.prices) == 1",
            "assert": true
          },
          {
            "key": "quantity",
            "expression": "facts[item.quantityField]",
            "assert": false
          },
          {
            "key": "amount",
            "expression": "item.override != null ? item.override : s.prices[0].values.amount * item.multiplier * s.quantity",
            "assert": false
          }
        ],
        "outputExpression": "[{itemId: item.rowId, group: 'main', kind: 'Emergency', amount: s.amount, profitRequired: false, tax: 'None'}]",
        "explanation": "חירום: שורה {item}, כמות {quantity}, סכום {amount}",
        "forEach": "tableRows",
        "groupBy": null,
        "tableOutputs": [
          {
            "name": "priceId",
            "type": "string",
            "role": "reference",
            "required": true
          },
          {
            "name": "multiplier",
            "type": "number",
            "role": "multiplier",
            "required": true
          },
          {
            "name": "quantityField",
            "type": "string",
            "role": "input",
            "required": true
          },
          {
            "name": "override",
            "type": "number",
            "role": "override",
            "required": false
          }
        ],
        "collections": null
      }
    ],
    "components": [
